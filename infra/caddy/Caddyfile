# RailFlow edge proxy.
#
# Local (`.env`: SITE_ADDRESS=http://localhost, http://*.localhost) serves plain
# HTTP and matches tenant subdomains (<slug>.localhost — browsers resolve these
# to loopback); compose maps HTTP_PORT -> 80. Do not add a port to SITE_ADDRESS
# locally — Caddy would then listen on that port inside the container instead of :80.
# In production set SITE_ADDRESS=your.domain, add the wildcard site
# (*.your.domain) and enable DNS-01 for it; see docs/DECISIONS.md section 5.
#
# Per-tenant custom domains (wildcard *.railflow.example.com): use the DNS-01
# challenge with your provider's Caddy plugin and an on-demand TLS `ask` endpoint,
# per docs/DECISIONS.md section 5.

{$SITE_ADDRESS:http://localhost:8080} {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		-Server
	}

	# API and liveness endpoints go straight to FastAPI.
	@api path /api/* /healthz /readyz /docs* /openapi.json /redoc*
	reverse_proxy @api backend:8000 {
		header_up X-Real-IP {remote_host}
	}

	# Everything else is the Next.js app (pages + static assets).
	reverse_proxy frontend:3000 {
		header_up X-Real-IP {remote_host}
	}
}
