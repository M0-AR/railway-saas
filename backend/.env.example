# Application (least-privileged role: NOSUPERUSER NOBYPASSRLS, see infra/postgres/init/01_roles.sql)
DATABASE_URL=postgresql+asyncpg://railway_app:railway_app_pw@localhost:5432/railway
# Migrations run as the schema owner (separate role)
MIGRATION_DATABASE_URL=postgresql+asyncpg://railway_owner:railway_owner_pw@localhost:5432/railway

ENVIRONMENT=local
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=14

# Origins allowed to call the API (frontend dev server)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Optional
REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_PER_MINUTE=240
AUTH_RATE_LIMIT_PER_MINUTE=20
SEED_DEMO=true
