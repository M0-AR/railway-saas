# Copy to .env — docker compose reads this file.

ENVIRONMENT=local

# --- Database -------------------------------------------------------------
POSTGRES_DB=railway
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# Passwords for the two app roles, created on first init (infra/postgres/init/01_roles.sh).
# Keep them URL-safe (letters, digits, - _) so they fit inside DATABASE_URL.
RAILWAY_OWNER_PASSWORD=railway_owner_pw
RAILWAY_APP_PASSWORD=railway_app_pw

# --- App secrets ----------------------------------------------------------
# Generate with: openssl rand -hex 32
SECRET_KEY=change-me-openssl-rand-hex-32

# --- Edge / domains -------------------------------------------------------
# Local: plain HTTP; the app is on http://localhost:8080 (Caddy listens on :80
# inside the container; HTTP_PORT maps it to the host).
# Production: your hostname, e.g. railflow.example.com — Caddy gets HTTPS
# automatically on 443. Then set HTTP_PORT=80 and HTTPS_PORT=443.
SITE_ADDRESS=http://localhost, http://*.localhost
HTTP_PORT=8080
HTTPS_PORT=8443
APP_DOMAIN=localhost

CORS_ORIGINS=http://localhost:8080,http://localhost:3000

# --- Optional -------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
SEED_DEMO=true
STRIPE_WEBHOOK_SECRET=
